<?xml version="1.0" encoding="utf-8"?>
<!-- Staging and release: HTTPS only, and only the system's certificate authorities, never ones a
     user installed (README §6.5). The debug build replaces this file with
     src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
