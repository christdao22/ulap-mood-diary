<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing goes to Google's cloud backup or to a device-to-device transfer
     (README §14). The encrypted database, its wrapped passphrase and the session keyset only work
     on the phone that made them; synced check-ins come back from the server after sign-in.
     The Phase 2 backup task decides whether settings may be allowed back in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
