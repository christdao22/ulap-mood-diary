{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "PowerShell(./gradlew *)",
      "PowerShell(.\\gradlew *)",
      "Bash(docker compose *)",
      "PowerShell(docker compose *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Read(*.jks)",
      "Read(*.keystore)"
    ]
  }
}
