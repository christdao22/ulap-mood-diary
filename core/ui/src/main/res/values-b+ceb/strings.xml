    <!-- Privacy notice (README §14). First draft. -->
    <string name="privacy_title">Privacy notice</string>
    <string name="privacy_intro">Ang Ulap usa ka mood diary. Mao kini ang paagi nga ang imong diary magpabiling pribado.</string>
    <string name="privacy_collect_title">Unsa ang gitipigan sa Ulap</string>
    <string name="privacy_collect_body">Imong mga check-in: mood, enerhiya, stress, unsa kini mahitungod, imong mga nota ug ang oras. Kung mag-sign in ka, apil usab ang imong email, imong ngalan kung magbutang ka, ug imong mga setting.</string>
    <string name="privacy_why_title">Ngano</string>
    <string name="privacy_why_body">Aron lang ipakita kanimo ang imong diary ug mga report, ug aron i-back up kini kung gusto nimo.</string>
    <string name="privacy_where_title">Asa kini gitipigan</string>
    <string name="privacy_where_body">Niining phone. Kung mag-sign in ka aron mag-back up, anaa usab sa server sa Ulap, diin naka-encrypt ang imong mga nota. Kaugalingong check-in lang ang makita sa matag account.</string>
    <string name="privacy_never_title">Ang dili gyud buhaton sa Ulap</string>
    <string name="privacy_never_body">Walay ads. Dili gyud ibaligya sa Ulap ang imong data o ipaambit sa mga advertiser. Dili apil ang imong mga nota o email sa crash reports.</string>
    <string name="privacy_delete_title">Pagpapas sa imong data</string>
    <string name="privacy_delete_body">Mahimo nimong papason ang bisan unsang check-in sa Listahan. Hapit na mahimo ang pagpapas sa tibuok account ug tanan nimong data sa Account.</string>

