<resources>
    <!-- The app name is the same in English, Filipino and Bisaya (README §13). -->
    <string name="app_name">Ulap</string>

    <!-- Bottom tab bar (design-spec.md §6.10) -->
    <string name="tab_check_in">Check in</string>
    <string name="tab_logs">Logs</string>
    <string name="tab_reports">Reports</string>
    <string name="tab_account">Account</string>

    <!-- Logs (design-spec.md §6.13, §7.6). The screen title is tab_logs. -->
    <string name="logs_today">Today</string>
    <string name="logs_yesterday">Yesterday</string>
    <!-- Day header. %1$d is how many check-ins that day, %2$s the average stress with one decimal, e.g. 4.4 -->
    <plurals name="logs_day_summary">
        <item quantity="one">%1$d check-in · avg stress %2$s</item>
        <item quantity="other">%1$d check-ins · avg stress %2$s</item>
    </plurals>
    <!-- TalkBack for the day header (design-spec.md §11), with "average" spelled out. %1$s is the day, %2$d the count, %3$s the average. -->
    <plurals name="logs_day_description">
        <item quantity="one">%1$s. %2$d check-in, average stress %3$s.</item>
        <item quantity="other">%1$s. %2$d check-ins, average stress %3$s.</item>
    </plurals>
    <!-- Log row, after the mood. %1$s is the time, %2$d the stress. -->
    <string name="logs_row_meta">%1$s · Stress %2$d</string>
    <!-- The same, with %3$s the trigger, e.g. Work -->
    <string name="logs_row_meta_trigger">%1$s · Stress %2$d · %3$s</string>
    <!-- TalkBack for a log row, read as one item (design-spec.md §11): %1$s mood, %2$s zone name, %3$s time, %4$s slider_state for stress, e.g. "8 of 10, high". -->
    <string name="logs_row_description">%1$s. %2$s. %3$s. Stress %4$s.</string>
    <!-- The same, with %5$s the trigger, e.g. Work -->
    <string name="logs_row_description_trigger">%1$s. %2$s. %3$s. Stress %4$s. Trigger: %5$s.</string>
    <!-- When the row has a journal note: %1$s is the description above, %2$s the note. -->
    <string name="logs_row_description_note">%1$s Journal: %2$s</string>
    <!-- Search field placeholder; TalkBack also reads it as the field's name (design-spec.md §7.6) -->
    <string name="logs_search_hint">Search mood, trigger or journal</string>
    <!-- TalkBack name of the X button that empties the search field -->
    <string name="logs_search_clear">Clear search</string>
    <!-- Zone filter chip that shows every zone (design-spec.md §6.12) -->
    <string name="logs_filter_all">All</string>
    <!-- When search or a zone chip leaves nothing to show (design-spec.md §7.6) -->
    <string name="logs_no_match">No check-ins match. Try another word or zone.</string>
    <!-- Logs before the first check-in, under a neutral Ulap (design-spec.md §7.6) -->
    <string name="logs_empty">Your check-ins will show up here.</string>
    <!-- The empty Logs screen's primary button: opens the Check in tab (design-spec.md §7.6) -->
    <string name="logs_check_in_now">Check in now</string>
    <!-- TalkBack name of the three-dot button on a log row (design-spec.md §5, §6.13). %1$s is the mood, %2$s the time, so each row's button is told apart. -->
    <string name="logs_row_menu">Edit or delete check-in: %1$s, %2$s</string>
    <!-- Log row menu items (design-spec.md §7.6). logs_delete is also the dialog's confirm button. -->
    <string name="logs_edit">Edit</string>
    <string name="logs_delete">Delete</string>
    <!-- Asked before a delete (design-spec.md §7.6): title, text, then Delete · Keep -->
    <string name="logs_delete_title">Delete this check-in?</string>
    <string name="logs_delete_text">This can\'t be undone.</string>
    <string name="logs_delete_keep">Keep</string>

    <!-- Pick a mood (design-spec.md §7.2). Night uses the evening greeting. -->
    <string name="greeting_morning">Good morning</string>
    <string name="greeting_afternoon">Good afternoon</string>
    <string name="greeting_evening">Good evening</string>
    <string name="pick_mood_question">How are you feeling right now?</string>
    <string name="pick_mood_reassurance">Any answer is okay.</string>
    <!-- TalkBack for a mood tile (design-spec.md §11): mood, zone, default stress. -->
    <string name="mood_tile_description">%1$s. %2$s. Default stress %3$d.</string>

    <!-- Check in · Details (design-spec.md §7.3) -->
    <string name="details_back">Back to moods</string>
    <string name="details_back_to_logs">Back to logs</string>
    <!-- When the check-in is logged: the weekday and date, then the time. -->
    <string name="details_logged_at">%1$s · %2$s</string>
    <string name="details_defaults">Default for %1$s: energy %2$d, stress %3$d</string>
    <string name="details_reset">Reset to default</string>
    <string name="details_trigger_question">What triggered it?</string>
    <string name="details_trigger_other_hint">In your own words</string>
    <string name="details_journal_label">Journal · optional</string>
    <string name="details_save">Save</string>

    <!-- Ulap's soft-mirror line on the Details header (technical-plan.md Appendix B, pre_*) -->
    <string name="pre_red">That can feel intense. I\'m right here.</string>
    <string name="pre_blue">Thanks for telling me. Take your time.</string>
    <string name="pre_yellow">Ooh, tell me more!</string>
    <string name="pre_green">That sounds peaceful.</string>

    <!-- The journal placeholder, per zone (technical-plan.md Appendix B, prompt_*) -->
    <string name="prompt_red">What\'s the worry? What part is in your control?</string>
    <string name="prompt_blue">What happened? What do you need right now?</string>
    <string name="prompt_yellow">What made this moment good?</string>
    <string name="prompt_green">What\'s helping you feel this way?</string>

    <!-- Ulap's response after Save (technical-plan.md Appendix B, resp_*). %1$s is the mood name, lowercased -->
    <string name="resp_red_title">That\'s a lot to carry right now.</string>
    <string name="resp_red_body">Feeling %1$s makes sense when things pile up. Your body is on high alert, and that\'s okay.</string>
    <string name="resp_blue_title">Thank you for being honest.</string>
    <string name="resp_blue_body">Low days happen. You don\'t have to fix this today.</string>
    <string name="resp_yellow_title">Love this!</string>
    <string name="resp_yellow_body">What made you feel %1$s? Remembering it can help on harder days.</string>
    <string name="resp_green_title">A calm moment.</string>
    <string name="resp_green_body">Notice what\'s helping you feel %1$s, so you can come back to it.</string>
    <string name="resp_hopeless_title">I\'m really glad you told me.</string>
    <string name="resp_hopeless_body">You don\'t have to go through this alone. Talking to someone can help, even right now.</string>

    <!-- The line under the response when an unpleasant check-in has a trigger (technical-plan.md Appendix B, trigger_line_*) -->
    <string name="trigger_line_work">Work can take a lot out of us.</string>
    <string name="trigger_line_family">The people closest to us can affect us the most.</string>
    <string name="trigger_line_money">Money worries are real, and tiring.</string>
    <string name="trigger_line_health">Your body is asking for some care.</string>
    <string name="trigger_line_school">Learning under pressure is hard.</string>

    <!-- The Response screen's buttons (design-spec.md §7.4, technical-plan.md Appendix B, resp_action_*) -->
    <string name="resp_action_breathe">Breathe with me · 1 minute</string>
    <string name="resp_action_small_helps">Something small that helps</string>
    <string name="resp_action_good_moment">Save to good moments</string>
    <string name="resp_action_later">Maybe later</string>
    <string name="resp_action_done">Done</string>

    <!-- The support card that replaces the buttons after the primary tap (design-spec.md §6.9, §7.4, technical-plan.md Appendix B, help_*) -->
    <string name="help_breathe_steps">In for 4 · hold for 2 · out for 6</string>
    <string name="help_breathe_sub">Follow the circle. Five slow breaths is enough.</string>
    <!-- The counter under a still circle when animations are off. %1$d is the seconds left in this part -->
    <string name="help_breathe_in">Breathe in · %1$d</string>
    <string name="help_breathe_hold">Hold · %1$d</string>
    <string name="help_breathe_out">Breathe out · %1$d</string>
    <string name="help_small_title">Want to try one?</string>
    <string name="help_small_water">Drink a glass of water</string>
    <string name="help_small_song">Play a song you like</string>
    <string name="help_small_stretch">Stretch your neck and shoulders</string>
    <string name="help_small_air">Open a window or step outside for a minute</string>
    <string name="help_small_message">Message someone, even just to say hi</string>
    <string name="help_small_sub">Even one is enough.</string>
    <string name="help_good_saved">Saved to your good moments</string>
    <string name="help_good_saved_sub">Moments like this are worth keeping.</string>

    <!-- The "How stressed do you feel now?" card, Red and Blue only (design-spec.md §7.4, technical-plan.md Appendix B, check_*) -->
    <string name="check_ready">When you\'re ready</string>
    <string name="check_title">How stressed do you feel now?</string>
    <string name="check_action">Check in</string>

    <!-- The After screen: stress before and now, then a message (design-spec.md §7.5, §10.4, technical-plan.md Appendix B, after_*) -->
    <!-- The two pills. %1$d is the stress the person logged, then the stress they feel now -->
    <string name="after_before">Before %1$d</string>
    <string name="after_now">Now %1$d</string>
    <!-- %1$d is the logged stress, %2$d is the stress now -->
    <string name="after_lower">Your stress went from %1$d to %2$d.</string>
    <!-- %1$d is how many points lower -->
    <plurals name="after_lower_sub">
        <item quantity="one">That\'s %1$d point lower. Remember what helped, so you can use it again.</item>
        <item quantity="other">That\'s %1$d points lower. Remember what helped, so you can use it again.</item>
    </plurals>
    <string name="after_same">Still at %1$d, and that\'s okay.</string>
    <string name="after_same_sub">Feelings take time to shift. Be gentle with yourself today.</string>
    <string name="after_higher">It went up to %1$d.</string>
    <string name="after_higher_sub">Thank you for checking honestly. If it keeps rising, reach out to someone you trust or call NCMH at 1553.</string>
    <!-- Hopeless only: the hotline card is right below, so no "if it keeps rising" and no "remember what helped" (design-spec.md §10.4) -->
    <string name="after_lower_sub_hopeless">I\'m glad something eased a little. Help is still here whenever you need it.</string>
    <string name="after_higher_sub_hopeless">Thank you for checking honestly. This sounds really heavy. Talking to someone can help, even right now.</string>
    <string name="after_action_week">See my week</string>

