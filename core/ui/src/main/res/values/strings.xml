    <!-- Privacy notice (README §14). A first draft; the written notice replaces it (PHASES.md Phase 8). -->
    <string name="privacy_title">Privacy notice</string>
    <string name="privacy_back">Back</string>
    <string name="privacy_intro">Ulap is a mood diary. Here\'s how Ulap keeps your diary private.</string>
    <string name="privacy_collect_title">What Ulap keeps</string>
    <string name="privacy_collect_body">Your check-ins: mood, energy, stress, what it was about, your notes and the time. If you sign in, also your email, your name if you add one, and your settings.</string>
    <string name="privacy_why_title">Why</string>
    <string name="privacy_why_body">Only to show you your diary and reports, and to back it up if you choose to.</string>
    <string name="privacy_where_title">Where it\'s kept</string>
    <!-- Say the phone copy is encrypted only once SQLCipher ships (PHASES.md Phase 2). -->
    <string name="privacy_where_body">On this phone. If you sign in to back up, also on Ulap\'s server, where your notes are encrypted. Each account sees only its own check-ins.</string>
    <string name="privacy_never_title">What Ulap never does</string>
    <string name="privacy_never_body">No ads. Ulap never sells your data or shares it with advertisers. Crash reports never include your notes or email.</string>
    <string name="privacy_delete_title">Deleting your data</string>
    <!-- Promise account deletion only once DELETE /me and the Account screen ship (Phase 6). -->
    <string name="privacy_delete_body">You can delete any check-in from Logs. Deleting your whole account and all your data from Account is coming soon.</string>
