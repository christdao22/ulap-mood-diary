    <!-- Privacy notice (README §14). First draft. -->
    <string name="privacy_title">Privacy notice</string>
    <string name="privacy_back">Bumalik</string>
    <string name="privacy_intro">Ang Ulap ay mood diary. Ganito pinapanatiling pribado ang diary mo.</string>
    <string name="privacy_collect_title">Ano ang sine-save ng Ulap</string>
    <string name="privacy_collect_body">Ang mga check-in mo: mood, enerhiya, stress, kung tungkol saan ito, ang mga tala mo at ang oras. Kapag nag-sign in ka, pati ang email mo, ang pangalan mo kung maglalagay ka, at ang mga setting mo.</string>
    <string name="privacy_why_title">Bakit</string>
    <string name="privacy_why_body">Para lang maipakita sa iyo ang diary at mga ulat mo, at para i-back up ito kung gusto mo.</string>
    <string name="privacy_where_title">Saan ito naka-save</string>
    <string name="privacy_where_body">Sa phone na ito. Kapag nag-sign in ka para mag-back up, nasa server din ng Ulap, kung saan naka-encrypt ang mga tala mo. Sariling check-in lang ang nakikita ng bawat account.</string>
    <string name="privacy_never_title">Ang hindi kailanman ginagawa ng Ulap</string>
    <string name="privacy_never_body">Walang ads. Hindi kailanman ibinebenta ng Ulap ang data mo o ibinabahagi sa mga advertiser. Hindi kasama ang mga tala o email mo sa crash reports.</string>
    <string name="privacy_delete_title">Pagbura ng data mo</string>
    <string name="privacy_delete_body">Puwede mong burahin ang kahit anong check-in sa Talaan. Malapit nang maging posible na burahin ang buong account at lahat ng data mo sa Account.</string>

