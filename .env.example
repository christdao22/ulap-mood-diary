# Server settings for local development (README §8). Copy it once:
#   cp .env.example .env
# ./gradlew :server:run reads .env. The real .env is gitignored. Every value below is a
# development placeholder, never a real secret: production values live only in infra/.env
# on the VPS (docs/runbooks/deploy.md).

# development migrates on startup and turns on Ktor development mode; production does neither.
APP_ENV=development
PORT=8080

# PostgreSQL from infra/compose.dev.yaml (port 5434, D13).
DATABASE_URL=jdbc:postgresql://localhost:5434/ulap
DATABASE_USER=ulap
DATABASE_PASSWORD=ulap
DATABASE_POOL_SIZE=10

# Access tokens (api-spec.md §3). Production needs 64+ random bytes: openssl rand -base64 64
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=ulap-app
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=60

# Google sign-in (README §6.6). Empty: only email sign-in works.
GOOGLE_WEB_CLIENT_ID=

# AES-256-GCM key for note and triggerOther: base64 of exactly 32 bytes.
# This one is 32 zero bytes, for development only. Make a real one with: openssl rand -base64 32
NOTE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
NOTE_ENCRYPTION_KEY_ID=dev1

# Mailpit catches every email in development: http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ulap <hello@ulap.test>

# Base URL for verification and reset links.
APP_LINK_BASE=http://localhost:8080

# Below this Android versionCode, routes answer 426 APP_UPDATE_REQUIRED.
MIN_ANDROID_VERSION_CODE=1

# Crash reports (D11). Empty sends nothing.
SENTRY_DSN=
